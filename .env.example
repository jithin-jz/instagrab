# Meta Developer App ID.
# Find it at developers.facebook.com > My Apps > your app > App settings > Basic.
# Example format: 123456789012345
IG_APP_ID=123456789012345

# Meta App Secret used to validate X-Hub-Signature-256 webhook HMACs.
# Find it at developers.facebook.com > My Apps > your app > App settings > Basic > App secret.
# Example format: a1b2c3d4e5f678901234567890abcdef
IG_APP_SECRET=a1b2c3d4e5f678901234567890abcdef

# Webhook verification token that you choose and also enter in Meta's webhook setup.
# Generate any long random string and keep it private.
# Example format: verify_9eac5b37f7f04f7b9d1d
IG_VERIFY_TOKEN=verify_9eac5b37f7f04f7b9d1d

# Instagram long-lived access token for your Instagram Business account.
# Generate it through Meta Graph API Explorer or your Meta app OAuth flow with required permissions.
# Example format: IGQVJYZA2ZA6bWZA0ZA0ZAQZA...
IG_ACCESS_TOKEN=IGQVJYZA2ZA6bWZA0ZA0ZAQZA

# Instagram Business Account ID for the target account that receives mentions.
# Find it via Graph API: GET /me/accounts, then GET /{page-id}?fields=instagram_business_account.
# Example format: 17841400000000000
IG_BUSINESS_ID=17841400000000000

# Telegram bot token from @BotFather.
# Create it in Telegram by messaging @BotFather, running /newbot, and copying the token.
# Example format: 1234567890:AAExampleTokenWithLettersAndNumbers
TG_BOT_TOKEN=1234567890:AAExampleTokenWithLettersAndNumbers

# Telegram Bot API base URL.
# Use https://api.telegram.org for Telegram cloud, or http://localhost:8081 for a local Bot API server.
# Example format: https://api.telegram.org
TG_LOCAL_SERVER_URL=https://api.telegram.org

# Secret token Telegram echoes back as X-Telegram-Bot-Api-Secret-Token.
# Generate any long random string. When set with BASE_URL, the bot uses webhook mode.
# Example format: tg_webhook_3f1b8c2a91d4
TG_WEBHOOK_SECRET=tg_webhook_3f1b8c2a91d4

# Force long polling instead of webhook mode (useful for local development).
# Set to 1 to enable; leave empty or 0 to use webhooks when BASE_URL + TG_WEBHOOK_SECRET are set.
TG_POLLING=

# Your personal Telegram chat ID for admin alerts and admin commands.
# Get it by messaging your bot, then visiting https://api.telegram.org/bot{TOKEN}/getUpdates.
# Example format: 123456789
ADMIN_TELEGRAM_ID=123456789

# Public HTTPS base URL for your FastAPI server.
# Required for Telegram webhook mode. Use your production domain or HTTPS ngrok URL during local testing.
# Example format: https://downloads.example.com
BASE_URL=https://downloads.example.com

# Optional SQLite database path.
# Docker Compose sets this to /data/instagrab.db automatically for persistent storage.
# Database path (default: /data/instagrab.db in Docker, instagrab.db locally)
DATABASE_PATH=instagrab.db

# Maximum number of media downloads processed in parallel.
MAX_CONCURRENT_DOWNLOADS=3

# Per-user delivery rate-limit window in seconds.
RATE_LIMIT_SECONDS=60
